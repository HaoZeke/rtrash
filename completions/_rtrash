#compdef rtrash trash-put trash-empty trash-list trash-restore trash-rm trash
# zsh completion for rtrash and multi-call names
# Preferred install: rtrash setup
# Or: rtrash completions zsh > …/zsh/site-functions/_rtrash

local -a put_opts empty_opts list_opts status_opts trash_stats_opts du_opts restore_opts undo_opts who_opts reap_opts finder_opts rm_opts config_opts

put_opts=(
  '(-f --force)'{-f,--force}'[ignore nonexistent files, never prompt]'
  '(-i)'-i'[prompt before every removal]'
  '(-I)'-I'[prompt once for more than three files or recursive]'
  '--interactive=-[prompt according to WHEN]::when:(never once always)'
  '(-r -R --recursive)'{-r,-R,--recursive}'[remove directories and contents]'
  '(-d --dir)'{-d,--dir}'[remove empty directories]'
  '(-v --verbose)'{-v,--verbose}'[explain what is being done]'
  '--one-file-system[accepted for rm compatibility (no-op)]'
  '--preserve-root=-[refuse /, home and mount points (default)]::mode:(all)'
  '--no-preserve-root[do not treat those specially]'
  '--trash-dir=[put into this trash root (creates layout if needed)]:path:_files -/'
  '--home-only[always use the home trash]'
  '--plain[skip TUI; require file operands on a TTY]'
  '--no-space-check[copy across devices even when space or inodes run low]'
  '--dry-run[run every check and print what would move]'
  '--in-use=[when a live process holds an item]:when:(warn refuse ignore)'
  '--json[print a JSON summary of trashed items]'
  '(- *)'--help'[display help and exit]'
  '(- *)'--version'[output version and exit]'
)

empty_opts=(
  '(-n --dry-run)'{-n,--dry-run}'[report what would be removed; show reclaimable size]'
  '(-v --verbose)'{-v,--verbose}'[print each removed item]'
  '(-f --force)'{-f,--force}'[do not ask]'
  '(-i --interactive)'{-i,--interactive}'[ask before emptying]'
  '--all-users[empty every writable user trash]'
  '*--trash-dir=[empty only this trash directory]:path:_files -/'
  '--home-only[only the home trash]'
  '--older-than=[only items trashed more than AGE ago (DAYS, 2h, 1d12h)]:age:'
  '--max-size=[remove items until the trash fits in SIZE]:size:'
  '--prune=[which items --max-size removes first]:policy:(oldest largest)'
  '--until-free=[remove the oldest items until each trash file system has SPEC free]:spec:'
  '--dangling[remove only records whose payload is gone]'
  '--all[let an unscoped empty remove items other puts left]'
  '--json[emit a JSON summary]'
  '--plain[skip TUI]'
  '(- *)'--help'[display help and exit]'
  '(- *)'--version'[output version and exit]'
  '1:days:'
)

list_opts=(
  '--home-only[only the home trash]'
  '*--trash-dir=[list only this trash directory]:path:_files -/'
  '--older-than=[only items trashed more than AGE ago (DAYS, 2h, 1d12h)]:age:'
  '--newer-than=[only items trashed within the last AGE]:age:'
  '--larger-than=[only items taking more than SIZE on disk]:size:'
  '--smaller-than=[only items taking less than SIZE on disk]:size:'
  '--json[emit a JSON array]'
  '--size[add each item size]'
  '--sort=[row order]:key:(date size name path)'
  '--reverse[reverse the order]'
  '--glob=[only items whose path or name matches a glob]:pattern:'
  '--regex=[only items whose original path matches RE]:regex:'
  '--name=[only items with this file name]:name:'
  '--cwd-only[only items from the current directory or below]'
  '--all-users[list every readable user trash with an owner column]'
  '--volumes[print the mount points searched and exit]'
  '--trash-dirs[print the trash directories read and exit]'
  '(- *)'--help'[display help and exit]'
  '(- *)'--version'[output version and exit]'
)

who_opts=(
  '--json[print a JSON object]'
  '(- *)'--help'[display help and exit]'
  '(- *)'--version'[output version and exit]'
)

reap_opts=(
  '*'{-p,--profile=}'[also reap a profile]:profile:(ai claude cursor codex aider ollama playwright puppeteer compilers cargo-target cargo-registry sccache ccache go zig bazel gradle jetbrains pkg pip pip-build uv npm pnpm yarn bun conda thumbnails)'
  '--list-profiles[list the profiles]'
  '--shared[show what a delete frees, counting shared extents once]'
  '--install-timer=-[write a user timer that runs this reap]:every:'
  '--watch=-[reap again every interval under --when-below]:interval:'
  '--remove-timer[stop and remove the reap timer]'
  '--timer-status[show whether the reap timer is installed]'
  '--when-below=[reap only when free space is under this]:spec:'
  '--until=[free space to reap back to]:spec:'
  '--purge-trash[empty the oldest trash items first when space is short]'
  '*--roots=[directories {roots} globs search]:dir:_files -/'
  '--depth=[how deep ** reaches]:depth:'
  '--tool[hand a profile to its tool cleanup]'
  '--trash[move to the trash, even for a permanent profile]'
  '--older-than=[only entries older than AGE]:age:'
  '--age-by=[times that count]:letters:'
  '(-n --dry-run)'{-n,--dry-run}'[show what would go, change nothing]'
  '--permanent[delete instead of trashing]'
  '--trash-dir=[put into this trash root]:path:_files -/'
  '--home-only[always use the home trash]'
  '(-v --verbose)'{-v,--verbose}'[also show skipped entries]'
  '--json[print a JSON object]'
  '(- *)'--help'[display help and exit]'
  '(- *)'--version'[output version and exit]'
)

trash_stats_opts=(
  '--top=[list the N largest items]:count:'
  '--home-only[only the home trash]'
  '*--trash-dir=[only this trash directory]:dir:_files -/'
  '--history[also show each trash history]'
  '--since=[with --history, only lines from the last AGE]:age:'
  '--total[only size and items, from the stored running total]'
  '--space[with --total, also give each trash file system free bytes and inodes]'
  '--exit-low[with --total, --space and exit 3 when a trash file system runs low]'
  '--measure[with --total, measure a trash whose total is missing or stale]'
  '--json[print a JSON object]'
  '--help[display help]'
  '--version[display version]'
)

status_opts=(
  '--home-only[only the home trash]'
  '*--trash-dir=[only this trash directory]:path:_files -/'
  '--older-than=[only count items trashed more than AGE ago (DAYS, 2h, 1d12h)]:age:'
  '--newer-than=[only count items trashed within the last AGE]:age:'
  '--larger-than=[only count items taking more than SIZE on disk]:size:'
  '--smaller-than=[only count items taking less than SIZE on disk]:size:'
  '--json[emit a JSON object]'
  '(- *)'--help'[display help and exit]'
  '(- *)'--version'[output version and exit]'
)

du_opts=(
  '(-n --top)'{-n,--top=}'[list N directories and N files]:N:'
  '(-x --one-file-system)'{-x,--one-file-system}'[skip directories on other file systems]'
  '(-L --follow-symlinks)'{-L,--follow-symlinks}'[follow symlinks; loops and repeats count once]'
  '--apparent[rank by apparent size instead of disk use]'
  '--sort=[rank rows by this key]:key:(disk apparent items inodes mtime)'
  '(-C --count)'{-C,--count}'[add an ITEMS column]'
  '--inodes[rank by inodes and total them]'
  '--unique[add a UNIQUE column of bytes no other file shares]'
  '--shared[count each shared extent once in sizes]'
  '--types[list disk use per file type instead of directories and files]'
  '--max-depth=[list only entries at most N levels deep]:N:'
  '--threads=[walk with N threads]:N:'
  '--all-dirs[list every directory level]'
  '--artefacts[list only regenerable build artefacts and caches]'
  '*--exclude=[leave out entries that match a gitignore-style pattern]:pattern:'
  '*'{-X,--exclude-from=}'[read exclude patterns from a file]:file:_files'
  '--exclude-caches[leave out directories with a valid CACHEDIR.TAG]'
  '--gitignore[leave out what git ignores]'
  '--dirs[list directories only]'
  '--files[list files only]'
  '--older-than=[only entries untouched for more than DAYS days]:DAYS:'
  '--newer-than=[only entries modified within the last DAYS days]:DAYS:'
  '--since=[only entries modified at or after DATE]:DATE:'
  '--until=[only entries last modified before DATE]:DATE:'
  '--home-only[only the home trash in the trash summary]'
  '--trash-dir=[only this trash directory in the summary]:path:_files -/'
  '--no-git[do not ask git about listed paths]'
  '--include-dirty[with --print0, also print rows with git work at risk]'
  '--json[emit a JSON object]'
  '--print0[print listed paths NUL-separated]'
  '--dupes[list groups of files with the same contents]'
  '--clone-dupes[reflink-clone every copy but one from the kept file]'
  '--link-dupes[hard-link every copy but one to the kept file]'
  '--trash-dupes[trash every copy but one in each group]'
  '--min-size=[with --dupes, skip smaller files]:size:'
  '--pick[mark listed rows in the put browser and trash them]'
  '(-i --interactive)'{-i,--interactive}'[explore one directory at a time; trash, undo, rescan]'
  '--no-delete[with -i, browse only: no trash or undo]'
  '--si[sizes in powers of 1000 (kB, MB, GB)]'
  '(-o --output)'{-o,--output=}'[write a snapshot of every directory total]:file:_files'
  '--stacks[print folded stacks for flame graph tools]'
  '--devices[list every mounted file system with its size and free space]'
  '(--ncdu-binary)--ncdu=[write an ncdu export of PATH]:file:_files'
  '(--ncdu)--ncdu-binary=[write an ncdu binary export of PATH (ncdu -O)]:file:_files'
  '(-f --file)'{-f,--file=}'[list from a snapshot or an ncdu export instead of scanning]:file:_files'
  '(- *)'--help'[display help and exit]'
  '(- *)'--version'[output version and exit]'
  '*:path:_files -/'
)

finder_opts=(
  '1:action:(put list restore)'
  '*--trash-dir=[use this Finder trash]:path:_files -/'
  '--all[restore every item with a Put Back record]'
  '(-f --force)'{-f,--force}'[put: ignore missing files; restore: overwrite]'
  '--conflict=[when the destination exists]:policy:(refuse overwrite rename skip)'
  '(-v --verbose)'{-v,--verbose}'[put: name each trashed file]'
  '--json[print JSON]'
  '(- *)'--help'[display help and exit]'
  '*:file:_files'
)

config_opts=(
  '(--default)--path[print where the config file is looked for]'
  '(--path)--default[print a config file with every setting commented out]'
  '(- *)'--help'[display help and exit]'
  '(- *)'--version'[output version and exit]'
)

undo_opts=(
  '(-l --list)'{-l,--list}'[list put runs, newest first]'
  '(-n --dry-run)'{-n,--dry-run}'[show what would be restored]'
  '(-f --force)'{-f,--force}'[overwrite existing files at original locations]'
  '--conflict=[when an original location is taken]:policy:(refuse overwrite rename skip)'
  '--json[print the result as JSON]'
  '--home-only[only the home trash]'
  '*--trash-dir=[only consider this trash directory]:path:_files -/'
  '(- *)'--help'[display help and exit]'
  '(- *)'--version'[output version and exit]'
  '1:batch id:'
)

restore_opts=(
  '(-f --force)'{-f,--force}'[overwrite existing file at original location]'
  '--home-only[only the home trash]'
  '*--trash-dir=[only consider this trash directory]:path:_files -/'
  '--cwd-only[only items trashed from under the current directory]'
  '--plain[numbered selection even on a TTY]'
  '--no-space-check[copy across devices even when space or inodes run low]'
  '(--oldest-first)--newest-first[list the most recently trashed item first]'
  '--overwrite[same as --force]'
  '--sort=[numbered table order]:order:(date path none)'
  '(--newest-first)--oldest-first[list the oldest trashed item first]'
  '(1 --glob --regex)--name=[match by file name or trash name]:name:'
  '(1 --name --regex)--glob=[match by shell pattern]:pattern:'
  '(1 --name --glob)--regex=[match original paths by regex]:regex:'
  '(--all)--latest[of several matches, restore the newest]'
  '(--latest)--all[of several matches, restore every one]'
  '--to=[restore into this directory]:dir:_files -/'
  '--conflict=[when the destination exists]:policy:(refuse overwrite rename skip)'
  '--json[print the result as JSON]'
  '(- *)'--help'[display help and exit]'
  '(- *)'--version'[output version and exit]'
  '1:path:_files'
)

rm_opts=(
  '*--trash-dir=[only consider this trash directory]:path:_files -/'
  '--home-only[only the home trash]'
  '--older-than=[only match items trashed more than AGE ago (DAYS, 2h, 1d12h)]:age:'
  '--newer-than=[only match items trashed within the last AGE]:age:'
  '--larger-than=[only match items taking more than SIZE on disk]:size:'
  '--smaller-than=[only match items taking less than SIZE on disk]:size:'
  '--batch=[only items from one put run (an ID or last)]:batch:'
  '(-n --dry-run)'{-n,--dry-run}'[list matches and reclaimable size; do not delete]'
  '(-f --force)'{-f,--force}'[allow mass patterns that match everything]'
  '(-v --verbose)'{-v,--verbose}'[print each permanently removed original path]'
  '--json[emit a JSON summary with matches]'
  '(- *)'--help'[display help and exit]'
  '(- *)'--version'[output version and exit]'
  '*:pattern:'
)

_rtrash_dispatch() {
  local cmd="${words[1]##*/}"
  case "$cmd" in
    trash-empty)
      _arguments -s -C $empty_opts
      return
      ;;
    trash-list)
      _arguments -s -C $list_opts
      return
      ;;
    trash-restore)
      _arguments -s -C $restore_opts
      return
      ;;
    trash-rm)
      _arguments -s -C $rm_opts
      return
      ;;
    trash-put | trash)
      _arguments -s -C $put_opts '*:file:_files'
      return
      ;;
  esac

  # rtrash: subcommands or put fallthrough
  local -a subcmds
  subcmds=(
    'put:move files to the trash (rm-compatible flags)'
    'empty:purge trashed items'
    'list:list trashed items'
    'status:item count and reclaimable size summary'
    'trash-stats:per-trash size, inodes, oldest and largest items'
    'du:find the largest directories and files to trash'
    'restore:restore a trashed item'
    'undo:restore everything one put run trashed'
    'rm:permanently delete matching trash entries'
    'who:list the live processes holding PATH'
    'reap:trash stale temp entries no live process holds'
    'finder:macOS Finder Trash with Put Back'
    'config:show the config file and the settings it makes'
    'setup:install multi-call links, completions, man page'
    'keys:show or sample the TUI keybind config'
    'completions:print embedded shell completion script'
    'man:print embedded man page to stdout'
  )

  local curcontext="$curcontext" state line
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[display help and exit]' \
    '(-V --version)'{-V,--version}'[output version and exit]' \
    '1: :->cmd' \
    '*::arg:->args'

  case "$state" in
    cmd)
      _describe -t commands 'rtrash command' subcmds
      _files
      ;;
    args)
      case "$line[1]" in
        put)
          _arguments -s -C $put_opts '*:file:_files'
          ;;
        empty)
          _arguments -s -C $empty_opts
          ;;
        list)
          _arguments -s -C $list_opts
          ;;
        trash-stats)
          _arguments -s -C $trash_stats_opts
          ;;
        status)
          _arguments -s -C $status_opts
          ;;
        du)
          _arguments -s -C $du_opts
          ;;
        restore)
          _arguments -s -C $restore_opts
          ;;
        undo)
          _arguments -s -C $undo_opts
          ;;
        who)
          _arguments -s -C $who_opts '*:file:_files'
          ;;
        reap)
          _arguments -s -C $reap_opts '*:file:_files'
          ;;
        finder)
          _arguments -s -C $finder_opts
          ;;
        config)
          _arguments -s -C $config_opts
          ;;
        rm)
          _arguments -s -C $rm_opts
          ;;
        setup)
          _arguments -s -C \
            '--prefix=[install root]:dir:_files -/' \
            '--bin-dir=[binary/link directory]:dir:_files -/' \
            '--with-rm[also link rm to rtrash]' \
            '--powershell-profile=-[also load the PowerShell completer from a profile]::profile:_files' \
            '(-n --dry-run)'{-n,--dry-run}'[print actions without writing]' \
            '(-f --force)'{-f,--force}'[replace existing links/files]' \
            '(-v --verbose)'{-v,--verbose}'[print each path written]' \
            '(- *)'--help'[display help and exit]'
          ;;
        completions)
          _arguments -s -C \
            '(- *)'--help'[display help and exit]' \
            '1:shell:(bash zsh fish nu powershell elvish)'
          ;;
        keys)
          _arguments -s -C \
            '(-l --list --sample --path)'{-l,--list}'[print the resolved keymap]' \
            '(-l --list --path)--sample[print a sample keys.toml]' \
            '(-l --list --sample)--path[print the config path]' \
            '(- *)'--help'[display help and exit]'
          ;;
        man)
          _arguments -s -C '(- *)'--help'[display help and exit]'
          ;;
        *)
          # bare path / rm-style flags after first non-subcommand word
          _arguments -s -C $put_opts '*:file:_files'
          ;;
      esac
      ;;
  esac
}

_rtrash_dispatch "$@"
